# Copy to .env.local for local development — never commit real values.
# The address of the backend API (no trailing slash).
# Local backend:       http://localhost:3000
# Deployed (Railway):  https://marketplace-backend-production-xxxx.up.railway.app
# This value is baked in when the site is BUILT, so after changing it on Vercel you must redeploy.
NEXT_PUBLIC_API_URL=http://localhost:3000
